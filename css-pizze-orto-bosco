    .c-tr { top: 4px; right: 4px; border-left: none; border-bottom: none; }
    .c-bl { bottom: 4px; left: 4px; border-right: none; border-top: none; }
    .c-br { bottom: 4px; right: 4px; border-left: none; border-top: none; }

    .menu-inner { position: relative; z-index: 1; }

    .header-block { text-align: center; margin-bottom: 40px; }
    .header-title { font-family: "Playfair Display", serif; font-size: 2.6rem; color: var(--gold); letter-spacing: 0.16em; text-transform: uppercase; font-weight: 700; text-shadow: 0 3px 12px rgba(0,0,0,0.6); }
