    .two-columns { display: flex; gap: 20px; margin-bottom: 45px; }
    .column-box { flex: 1; padding: 20px; background: rgba(0, 0, 0, 0.4); border: 1px solid rgba(230, 196, 99, 0.08); }
    .column-title { font-family: "Playfair Display", serif; text-align: center; color: var(--gold); margin-bottom: 12px; font-size: 0.98rem; letter-spacing: 0.1em; text-transform: uppercase; }
